<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_adaptive_bridge_plugin"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".AdaptiveBridgeConfigActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="com.streamvault.plugin.adaptivebridge.CONFIGURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".StreamVaultAdaptiveBridgePluginService"
            android:exported="true"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="com.streamvault.plugin.API" />
            </intent-filter>
            <meta-data
                android:name="com.streamvault.plugin.MANIFEST_JSON"
                android:value="{&quot;schemaVersion&quot;:1,&quot;id&quot;:&quot;com.streamvault.plugins.adaptivebridge&quot;,&quot;name&quot;:&quot;StreamVault Adaptive Bridge&quot;,&quot;versionName&quot;:&quot;1.1.20-beta.1&quot;,&quot;versionCode&quot;:23,&quot;description&quot;:&quot;Bridge for Kodi inputstream.adaptive-style M3U/KODIPROP sources in StreamVault.&quot;,&quot;providerName&quot;:&quot;StreamVault Adaptive Bridge&quot;,&quot;configurationMode&quot;:&quot;activity&quot;,&quot;configurationActivityAction&quot;:&quot;com.streamvault.plugin.adaptivebridge.CONFIGURE&quot;,&quot;capabilities&quot;:[&quot;provider.m3u&quot;,&quot;playback.prepare&quot;,&quot;configuration.activity&quot;]}" />
            <meta-data
                android:name="com.streamvault.plugin.ID"
                android:value="com.streamvault.plugins.adaptivebridge" />
            <meta-data
                android:name="com.streamvault.plugin.NAME"
                android:value="StreamVault Adaptive Bridge" />
            <meta-data
                android:name="com.streamvault.plugin.VERSION_NAME"
                android:value="1.1.20-beta.1" />
            <meta-data
                android:name="com.streamvault.plugin.VERSION_CODE"
                android:value="23" />
            <meta-data
                android:name="com.streamvault.plugin.DESCRIPTION"
                android:value="Bridge for Kodi inputstream.adaptive-style M3U/KODIPROP sources in StreamVault." />
            <meta-data
                android:name="com.streamvault.plugin.PROVIDER_NAME"
                android:value="StreamVault Adaptive Bridge" />
            <meta-data
                android:name="com.streamvault.plugin.CONFIGURATION_MODE"
                android:value="activity" />
            <meta-data
                android:name="com.streamvault.plugin.CONFIGURATION_ACTIVITY_ACTION"
                android:value="com.streamvault.plugin.adaptivebridge.CONFIGURE" />
            <meta-data
                android:name="com.streamvault.plugin.CAPABILITIES"
                android:value="provider.m3u,playback.prepare,configuration.activity" />
        </service>
    </application>
</manifest>
